{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Открыть Finni в Cursor",
      "type": "shell",
      "command": "echo ${input:openSimpleBrowser}",
      "problemMatcher": [],
      "presentation": {
        "reveal": "never",
        "echo": false,
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "close": true
      }
    }
  ],
  "inputs": [
    {
      "id": "openSimpleBrowser",
      "type": "command",
      "command": "simpleBrowser.api.open",
      "args": {
        "url": "http://127.0.0.1:8080"
      }
    }
  ]
}
